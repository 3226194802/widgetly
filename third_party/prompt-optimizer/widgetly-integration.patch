+// Widgetly integration bridge.
+//
+// The Prompt Optimizer application still owns its models, templates, history,
+// favorites and workspaces. Widgetly only sends a plain prompt and receives a
+// plain optimized result. Keeping this bridge deliberately small also lets the
+// full workbench be created on demand and destroyed again after quick use.
+type WidgetlyBridgeMessage = {
+  source?: string
+  type?: string
+  requestId?: string
+  prompt?: string
+  strength?: number
+}
+
+const postToWidgetly = (payload: Record<string, unknown>) => {
+  if (typeof window === 'undefined' || window.parent === window) return
+  window.parent.postMessage({ source: 'prompt-optimizer', ...payload }, '*')
+}
+
+const widgetlyTemplateByStrength: Record<number, string> = {
+  1: 'user-prompt-basic',
+  2: 'user-prompt-planning',
+  3: 'user-prompt-professional',
+}
+
+let widgetlyBridgeBusy = false
+
+const handleWidgetlyBridgeMessage = async (event: MessageEvent<WidgetlyBridgeMessage>) => {
+  if (typeof window === 'undefined' || event.source !== window.parent) return
+  const message = event.data
+  if (!message || message.source !== 'widgetly-shell') return
+  if (
+    message.type !== 'widgetly:hydrate'
+    && message.type !== 'widgetly:optimize'
+    && message.type !== 'widgetly:open-model-manager'
+  ) return
+
+  const requestId = String(message.requestId || '')
+  const prompt = String(message.prompt || '').trim().slice(0, 16000)
+  const strength = Math.max(1, Math.min(3, Math.round(Number(message.strength) || 1)))
+
+  if (!prompt && message.type !== 'widgetly:open-model-manager') {
+    postToWidgetly({ type: 'widgetly:error', requestId, error: '请先输入需要优化的内容' })
+    return
+  }
+  if (!services.value || !hasRestoredInitialState.value) {
+    postToWidgetly({ type: 'widgetly:error', requestId, error: '专业工作台仍在初始化，请稍后重试' })
+    return
+  }
+  if (widgetlyBridgeBusy) {
+    postToWidgetly({ type: 'widgetly:error', requestId, error: '已有提示词正在处理中' })
+    return
+  }
+
+  widgetlyBridgeBusy = true
+  try {
+    await navigateToSubModeKeyCompat('basic-user', { replace: true })
+    await nextTick()
+
+    if (message.type === 'widgetly:open-model-manager') {
+      modelManager.showConfig = true
+      postToWidgetly({ type: 'widgetly:hydrated', requestId })
+      return
+    }
+
+    basicUserSession.updatePrompt(prompt)
+    basicUserSession.updateOptimizedResult({
+      optimizedPrompt: '',
+      reasoning: '',
+      chainId: '',
+      versionId: '',
+    })
+
+    const templateId = widgetlyTemplateByStrength[strength] || widgetlyTemplateByStrength[1]
+    const template = await services.value.templateManager.getTemplate(templateId)
+    optimizer.selectedUserOptimizeTemplate = template
+    basicUserSession.updateTemplate(templateId)
+    await basicUserSession.saveSession()
+
+    if (message.type === 'widgetly:hydrate') {
+      postToWidgetly({ type: 'widgetly:hydrated', requestId })
+      return
+    }
+
+    if (!basicUserSession.selectedOptimizeModelKey) {
+      modelManager.showConfig = true
+      postToWidgetly({
+        type: 'widgetly:needs-model',
+        requestId,
+        error: '请先在专业工作台配置并选择一个优化模型',
+      })
+      return
+    }
+
+    const optimizationStartedAt = Date.now()
+    postToWidgetly({ type: 'widgetly:optimizing', requestId })
+    await optimizer.handleOptimizePrompt()
+
+    const result = String(basicUserSession.optimizedPrompt || '').trim()
+    if (!result) {
+      postToWidgetly({
+        type: 'widgetly:error',
+        requestId,
+        error: '没有生成优化结果，请检查模型配置或在专业工作台重试',
+      })
+      return
+    }
+
+    // The upstream streaming callback normally creates the history chain. Keep
+    // this on-demand iframe alive long enough for that IndexedDB write, then add
+    // the same record ourselves only if no matching chain exists. Without this
+    // guard Widgetly could destroy the page after receiving the text but before
+    // the asynchronous history callback commits.
+    let historyChain: PromptRecordChain | undefined
+    const historyDeadline = Date.now() + 1500
+    while (!historyChain && Date.now() < historyDeadline) {
+      const chains = await services.value.historyManager.getAllChains()
+      historyChain = chains.find(chain => (
+        chain.rootRecord.originalPrompt === prompt
+        && chain.currentRecord.optimizedPrompt === result
+        && chain.rootRecord.timestamp >= optimizationStartedAt - 1000
+      ))
+      if (!historyChain) await new Promise(resolve => setTimeout(resolve, 50))
+    }
+    if (!historyChain) {
+      const recordId = globalThis.crypto?.randomUUID?.()
+        || `widgetly-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`
+      historyChain = await services.value.historyManager.createNewChain({
+        id: recordId,
+        originalPrompt: prompt,
+        optimizedPrompt: result,
+        type: 'userOptimize',
+        modelKey: basicUserSession.selectedOptimizeModelKey,
+        templateId,
+        timestamp: Date.now(),
+        metadata: { optimizationMode: 'user', functionMode: 'basic', source: 'widgetly' },
+      })
+    }
+    optimizer.currentChainId = historyChain.chainId
+    optimizer.currentVersions = historyChain.versions
+    optimizer.currentVersionId = historyChain.currentRecord.id
+    basicUserSession.updateOptimizedResult({
+      optimizedPrompt: result,
+      reasoning: String(basicUserSession.reasoning || ''),
+      chainId: historyChain.chainId,
+      versionId: historyChain.currentRecord.id,
+    })
+    await basicUserSession.saveSession()
+    postToWidgetly({ type: 'widgetly:result', requestId, result })
+  } catch (error) {
+    postToWidgetly({
+      type: 'widgetly:error',
+      requestId,
+      error: error instanceof Error ? error.message : String(error),
+    })
+  } finally {
+    widgetlyBridgeBusy = false
+  }
+}
+
